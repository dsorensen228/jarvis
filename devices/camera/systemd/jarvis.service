[Unit]
Description=Jarvis Raspberry Pi AI Camera
Documentation=file:%h/jarvis/devices/camera/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jarvis/devices/camera
EnvironmentFile=%h/.config/jarvis/camera.env
ExecStart=%h/jarvis/devices/camera/.venv/bin/jarvis-camera
Restart=always
RestartSec=3
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
