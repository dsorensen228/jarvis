# Required. This file is installed as ~/.config/jarvis/voice.env with mode 0600.
JARVIS_API_URL=http://jarvis-api.local:8000
JARVIS_USERNAME=
JARVIS_PASSWORD=
JARVIS_DEVICE_ID=
JARVIS_ROOM=

# Usually auto-detected from the attached ReSpeaker. Set only if PipeWire gives it an odd name.
JARVIS_AUDIO_INPUT=
JARVIS_AUDIO_OUTPUT=

# The kiosk and voice process are one service; disable only on a headless device.
JARVIS_UI_ENABLED=true
JARVIS_UI_HOST=127.0.0.1
JARVIS_UI_PORT=8765

# Manual Code Factory UI. Keep false except on explicitly enabled touchscreens.
JARVIS_CODING_TASKS_ENABLED=false
JARVIS_CODING_PROMPT_MAX_SECONDS=180

# Music (Spotify) bottom-nav tab. Keep false except on devices that should show it.
JARVIS_MUSIC_TAB_ENABLED=false

# Wake/VAD timing. These tune thresholds; they do not select operating modes.
# Kitchen and mudroom default to 0.63 (5% less sensitive than the prior 0.60 fleet floor).
JARVIS_WAKE_THRESHOLD=0.68
JARVIS_WAKE_CONSECUTIVE_HITS=2
JARVIS_UTTERANCE_SILENCE_MS=800
JARVIS_UTTERANCE_MAX_SECONDS=20
JARVIS_FOLLOW_UP_SECONDS=8
JARVIS_PERSONALITY_LEVEL=2
JARVIS_CONVERSATION_IDLE_SECONDS=1800

# Optional Spotify touchscreen integration.
JARVIS_SPOTIFY_CLIENT_ID=
JARVIS_SPOTIFY_PLAYER_NAME=
JARVIS_SPOTIFY_WEB_PLAYBACK_VOLUME=0.42
JARVIS_WATCHMODE_API_KEY=
JARVIS_WATCHMODE_REGION=US
JARVIS_WATCHMODE_PREFERRED_SOURCES=Netflix,Hulu,Disney+,HBO Max,Prime Video,Apple TV+,Peacock,Paramount Plus

JARVIS_LOG_LEVEL=INFO
