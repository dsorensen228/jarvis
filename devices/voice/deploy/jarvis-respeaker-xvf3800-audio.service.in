[Unit]
Description=Configure ReSpeaker XVF3800 audio
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service pipewire-pulse.service
Before=jarvis.service

[Service]
Type=oneshot
ExecStart=@JARVIS_ROOT@/devices/voice/scripts/setup-xvf3800-audio.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target
