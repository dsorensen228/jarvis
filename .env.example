JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DATA_DIR=/app/data
JARVIS_JWT_SECRET=replace-with-at-least-32-random-bytes
JARVIS_BOOTSTRAP_USERNAME=admin
JARVIS_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# Include every hostname assigned to the Cloud Run web service. Cloud Run may expose both a
# generated-hash URL and a project-number URL for the same service.
JARVIS_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional Gmail read/search integration.
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/integrations/gmail/callback
JARVIS_WEB_APP_URL=http://localhost:8080

# Human Google login. Values are stable Google account `sub` claims, not email addresses.
# Only these identities can exchange a Google ID token for the local owner account.
JARVIS_GOOGLE_LOGIN_SUBJECTS=

# Search, weather, and local-time tools. OpenAI supplies a concise, complete
# spoken web answer; Tavily is the automatic fallback.
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_WEB_MODEL=gpt-4o
JARVIS_TAVILY_API_KEY=
JARVIS_WEATHER_DEFAULT_LOCATION=Springfield IL 62701
JARVIS_TIMEZONE=America/New_York

# Home Assistant owns every smart-home device integration, discovery, and state.
# Use its LAN address: mDNS names do not resolve inside the API container. The
# token is a long-lived access token created in Home Assistant; it is a
# deployment secret and is never returned by the Jarvis API.
JARVIS_HOME_ASSISTANT_URL=http://192.0.2.35:8123
JARVIS_HOME_ASSISTANT_TOKEN=
JARVIS_HOME_ASSISTANT_REQUEST_TIMEOUT_SECONDS=10

# LLM weight experiment: heretic (default) is an abliterated Qwen3-30B-A3B
# Instruct 2507; set to stock and restart the llm container to revert.
JARVIS_LLM_VARIANT=heretic
# Optional overrides (leave unset to follow JARVIS_LLM_VARIANT):
# JARVIS_LLM_MODEL=qwen3-30b-a3b-instruct-2507-heretic
# LLM_MODEL_FILE=qwen3-30b-a3b-instruct-2507-heretic-q4_k_m.gguf
# 16K comfortably fits Jarvis's bounded recent transcript and leaves the
# Jetson considerably more responsive than a 32K reservation.
JARVIS_LLM_CONTEXT_TOKENS=16384
JARVIS_LLM_MAX_OUTPUT_TOKENS=1024
JARVIS_VISION_MODEL=qwen3-vl-4b-instruct
VISION_MODEL_FILE=Qwen3VL-4B-Instruct-Q4_K_M.gguf
VISION_MMPROJ_FILE=mmproj-Qwen3VL-4B-Instruct-Q8_0.gguf

WHISPER_MODEL=Systran/faster-distil-whisper-large-v3
# Jarvis's voice is a fixed British male blend in the TTS service.
KOKORO_SPEED=1.2

# The current jarvis-api.local host is JetPack 5 / L4T 35.4.1 (CUDA 11.4).
L4T_BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r35.4.1
LLAMA_CPP_REF=b6941
