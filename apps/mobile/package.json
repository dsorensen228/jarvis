{
  "name": "@jarvis/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "build:web": "expo export -p web",
    "build:brand-assets": "node scripts/generate-brand-assets.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/verify-coding-task-modal-layout.mjs scripts/verify-code-task-state.mjs scripts/verify-code-task-page-requests.mjs scripts/verify-timer-state.mjs scripts/verify-tv-remote.mjs scripts/verify-camera-feed.mjs tests/*.test.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/vector-icons": "~14.0.4",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "^4.5.5",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-oauth/google": "^0.13.5",
    "expo": "~52.0.0",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-notifications": "^0.29.14",
    "expo-router": "~4.0.22",
    "expo-status-bar": "~2.0.1",
    "jwt-decode": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@playwright/test": "1.63.0",
    "@types/react": "~18.3.12",
    "jimp-compact": "0.16.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.3.0"
  },
  "overrides": {
    "expo-font": "13.0.4"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native",
          "expo-av",
          "react-native-markdown-display"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
