{
  "name": "@jarvis/device-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/verify-dist.mjs && node scripts/verify-camera-fit.mjs",
    "test": "node scripts/verify-camera-fit.mjs && node scripts/verify-alarm-tone.mjs && node scripts/verify-spotify-search-covers.mjs && node scripts/test-jarvis-reachability.mjs && node --import ./scripts/register-test-loader.mjs --test tests/*.test.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
